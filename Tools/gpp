#!/usr/bin/env bash
# gpp — compile, run and test competitive programming solutions.
#
# Everything for a problem lives in one folder next to the source:
#   67A.cpp
#   .gpp/67A/
#       exe          compiled binary
#       1.in  1.ans  sample 1 (expected output may also be named 1.out)
#       2.in  2.ans  sample 2 ...
#       1.got        your program's output from the last test run

usage() {
    cat <<EOF
Usage: $(basename "$0") file.cpp [options] [input]
       $(basename "$0") -c [dir]    delete exe/.got/.err (and old .build/) under dir (default .)

  (no option)  build if needed, then test against samples (or run if none)
  -b           force rebuild
  -r [input]   run interactively; input may be a file or a literal string
  -t           test against all samples in .gpp/<name>/
  -a [n]       add n new samples, default 1 (paste input, Ctrl-D, paste answer, Ctrl-D)
  -l           list samples
  -T secs      time limit per test (default 2)
EOF
    exit 1
}

[[ $# -lt 1 ]] && usage

# Clean build artifacts recursively; samples (.in/.ans/.out) are kept.
if [[ $1 == -c ]]; then
    root=${2:-.}
    [[ ! -d $root ]] && echo "Error: Not a directory: $root" && exit 1
    find "$root" -path '*/.gpp/*' -type f \( -name exe -o -name '*.got' -o -name '*.err' \) -print -delete
    find "$root" -type d -name .build -prune -print -exec rm -rf {} +
    # Drop problem folders left empty, then empty .gpp folders.
    find "$root" -path '*/.gpp/*' -type d -empty -print -delete
    find "$root" -type d -name .gpp -empty -print -delete
    exit 0
fi

SOURCE=$1
shift
[[ ! -f $SOURCE ]] && echo "Error: Source file not found: $SOURCE" && exit 1

DIR=$(dirname "$SOURCE")
FILE=$(basename "$SOURCE")
NAME=$(basename "$SOURCE" .cpp)
WORK="$DIR/.gpp/$NAME"
EXE="$WORK/exe"
TL=2
mkdir -p "$WORK"

if [[ -t 1 ]]; then
    RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[34m' DIM=$'\e[2m' BOLD=$'\e[1m' RESET=$'\e[0m'
fi

now() { date +%s.%N; }
elapsed() { printf "%.2f" "$(echo "$(now) - $1" | bc)"; }

build() {
    echo "Building $FILE"
    local start
    start=$(now)
    if g++ -std=c++20 -O2 -Wall -Wextra -Wshadow -Wduplicated-cond -Wlogical-op "$SOURCE" -o "$EXE"; then
        echo "Build done in $(elapsed "$start")s"
    else
        echo "${RED}Build failed.${RESET}"
        exit 1
    fi
}

ensure_built() {
    [[ ! -x $EXE || $SOURCE -nt $EXE ]] && build
    return 0
}

run() {
    ensure_built
    local input=$1 start
    echo "Running $NAME"
    start=$(now)
    if [[ -z $input ]]; then
        "$EXE"
    elif [[ -r $input ]]; then
        "$EXE" <"$input"
    else
        echo "$input" | "$EXE"
    fi
    echo
    echo "Execute done in $(elapsed "$start")s"
}

# Sample inputs, sorted numerically (1.in, 2.in, ..., 10.in).
samples() {
    find "$WORK" -maxdepth 1 -name '*.in' -printf '%f\n' | sort -V
}

expected_for() {
    local base=$1
    for ext in ans out; do
        [[ -f "$WORK/$base.$ext" ]] && echo "$WORK/$base.$ext" && return
    done
}

# Ignore trailing whitespace on each line and trailing blank lines.
# (awk also adds the final newline if the output didn't end with one.)
normalize() {
    awk '{ sub(/[[:space:]]+$/, ""); line[NR] = $0 }
         END { n = NR; while (n > 0 && line[n] == "") n--
               for (i = 1; i <= n; i++) print line[i] }' "$1"
}

test_all() {
    ensure_built
    local list
    list=$(samples)
    if [[ -z $list ]]; then
        echo "No samples in $WORK (add one with: $(basename "$0") $SOURCE -a)"
        return 1
    fi

    local passed=0 total=0 in base ans got start t status verdict
    while read -r in; do
        base=${in%.in}
        ans=$(expected_for "$base")
        got="$WORK/$base.got"
        total=$((total + 1))

        start=$(now)
        timeout "$TL" "$EXE" <"$WORK/$in" >"$got" 2>"$WORK/$base.err"
        status=$?
        t=$(elapsed "$start")

        if [[ $status -eq 124 ]]; then
            verdict="${YELLOW}TLE${RESET}"
        elif [[ $status -ne 0 ]]; then
            verdict="${RED}RE (exit $status)${RESET}"
        elif [[ -z $ans ]]; then
            verdict="${BLUE}?? (no answer file)${RESET}"
        elif diff -q <(normalize "$ans") <(normalize "$got") >/dev/null; then
            verdict="${GREEN}AC${RESET}"
            passed=$((passed + 1))
        else
            verdict="${RED}WA${RESET}"
        fi

        printf "${BOLD}Test %s${RESET}: %s ${DIM}(%ss)${RESET}\n" "$base" "$verdict" "$t"

        if [[ $verdict != *AC* ]]; then
            echo "${DIM}--- input ---${RESET}"
            cat "$WORK/$in"
            if [[ -n $ans ]]; then
                echo "${DIM}--- expected ---${RESET}"
                cat "$ans"
            fi
            echo "${DIM}--- got ---${RESET}"
            cat "$got"
            [[ -n $(tail -c1 "$got") ]] && echo # keep layout if no final newline
            if [[ -s "$WORK/$base.err" ]]; then
                echo "${DIM}--- stderr ---${RESET}"
                cat "$WORK/$base.err"
            fi
            echo
        fi
        [[ -s "$WORK/$base.err" ]] || rm -f "$WORK/$base.err"
    done <<<"$list"

    if [[ $passed -eq $total ]]; then
        echo "${GREEN}${BOLD}All $total passed${RESET}"
    else
        echo "${RED}${BOLD}$passed/$total passed${RESET}"
        return 1
    fi
}

# Typed text goes to temp files first and is only moved into place once the
# sample is complete, so Ctrl-C (or an empty input) leaves nothing behind.
TMPFILES=()
trap 'rm -f "${TMPFILES[@]}"' EXIT
trap 'echo; echo "Cancelled."; exit 130' INT

add_sample() {
    local count=${1:-1} i n tin tans
    if [[ ! $count =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: -a takes a positive number of samples, got: $count"
        return 1
    fi
    for ((i = 1; i <= count; i++)); do
        n=1
        while [[ -e "$WORK/$n.in" ]]; do n=$((n + 1)); done
        tin=$(mktemp "$WORK/.tmp.XXXXXX")
        tans=$(mktemp "$WORK/.tmp.XXXXXX")
        TMPFILES=("$tin" "$tans")

        [[ $count -gt 1 ]] && echo "${BOLD}[$i/$count]${RESET}"
        echo "Sample $n input (Ctrl-D to finish, Ctrl-C to cancel):"
        cat >"$tin"
        if [[ ! -s $tin ]]; then
            echo "Empty input, sample not saved."
            rm -f "$tin" "$tans"
            TMPFILES=()
            return 1
        fi
        echo "Sample $n expected output (Ctrl-D to finish, empty to skip):"
        cat >"$tans"

        mv "$tin" "$WORK/$n.in"
        if [[ -s $tans ]]; then mv "$tans" "$WORK/$n.ans"; else rm -f "$tans"; fi
        TMPFILES=()
        echo "${GREEN}Saved sample $n${RESET}"
    done
}

list_samples() {
    local list
    list=$(samples)
    [[ -z $list ]] && echo "No samples in $WORK" && return
    while read -r in; do
        echo "${BOLD}${in%.in}${RESET} ${DIM}($WORK)${RESET}"
    done <<<"$list"
}

# No options: build if needed, then test (or run if there are no samples).
if [[ $# -eq 0 ]]; then
    if [[ -n $(samples) ]]; then
        test_all
    else
        run
    fi
    exit
fi

ACTIONS=()
while getopts "brtalT:" OPTION; do
    case "$OPTION" in
        b) ACTIONS+=(build) ;;
        r) ACTIONS+=(run) ;;
        t) ACTIONS+=(test_all) ;;
        a) ACTIONS+=(add_sample) ;;
        l) ACTIONS+=(list_samples) ;;
        T) TL=$OPTARG ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
INPUT=$1

[[ ${#ACTIONS[@]} -eq 0 ]] && ACTIONS=(test_all)
rc=0
for action in "${ACTIONS[@]}"; do
    if [[ $action == run ]]; then
        run "$INPUT" || rc=$?
    elif [[ $action == add_sample ]]; then
        add_sample "$INPUT" || rc=$?
    else
        $action || rc=$?
    fi
done
exit $rc
